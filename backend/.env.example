BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
AI_CODER_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Optional Groq credentials and model settings:
# AI_CODER_GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_TIMEOUT_SECONDS=60
# Codex CLI uses the local sign-in and low reasoning effort.
# AI_CODER_CODEX_EXECUTABLE=codex
# AI_CODER_CODEX_MODEL=gpt-5.6-luna
# AI_CODER_CODEX_TIMEOUT_SECONDS=150
# AI_CODER_CODEX_TRANSPORT=app-server
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_SECONDS=60
# Optional request metadata JSONL; contains no keys or message text.
# CHAT_RECORD_PATH=/absolute/path/to/chat.jsonl
# Shared chat/agent AI-call metadata (not conversation contents).
# LLM_RECORD_PATH=/absolute/path/to/llm.jsonl
# Optional: otherwise add your key through the chat panel (memory only).
# GEMINI_API_KEY=

# Optional overrides; defaults are defined in src/ai_coder/config.py.
# AI_CODER_WORKSPACES_ROOT=/absolute/path/to/workspaces
# AI_CODER_AGENT_TIMEOUT_SECONDS=600
# AI_CODER_MAX_FEATURES=4
# AI_CODER_MAX_REPAIRS=3
# Optional host-managed runtime acceptance check.
# AI_CODER_PROJECT_VERIFIER=/absolute/path/to/trusted-verifier
